# Copy this file to .env (docker compose reads it automatically). Never commit .env.

# ---- Shared secrets ---------------------------------------------------------
# HMAC-SHA256 secret shared by auth-service (signs tokens) and api-gateway (verifies tokens).
# Must be at least 32 bytes. Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-me-with-a-random-string-of-at-least-32-characters

# ---- Config Server ----------------------------------------------------------
CONFIG_SERVER_USER=config-user
CONFIG_SERVER_PASSWORD=change-me-config-password

# ---- Infrastructure URLs (docker-compose overrides these per container) ----
EUREKA_URL=http://localhost:8761/eureka/
CONFIG_SERVER_URL=http://localhost:8888

# ---- CORS (comma separated origin patterns allowed at the gateway) ---------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# ---- MySQL ------------------------------------------------------------------
# Local run (no Docker): the config-server defaults already point every service at
# jdbc:mysql://localhost:3306/retail_db as root/System, so nothing needs to be exported.
# Override with MYSQL_HOST / MYSQL_PORT / MYSQL_DATABASE / MYSQL_USER / MYSQL_PASSWORD when needed.
MYSQL_DATABASE=retail_db
# docker compose only: MYSQL_USER/MYSQL_PASSWORD create the application user in the mysql container
# (must not be root) and are passed to every service container.
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=insurance
MYSQL_PASSWORD=insurance
# ---- E-mail (notification-service) -------------------------------------------
# MOCK (default) only logs messages. SMTP sends real mail through Gmail: turn on 2-Step Verification for the
# Google account, create an App Password at https://myaccount.google.com/apppasswords and paste the 16 characters
# (spaces optional) below. Other relays: also set SMTP_HOST / SMTP_PORT.
NOTIFICATION_EMAIL_PROVIDER=MOCK
GMAIL_USERNAME=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
NOTIFICATION_EMAIL_FROM_NAME=Insurance Platform
# First ADMIN account created by auth-service at startup (leave empty to skip)
ADMIN_EMAIL=admin@insurance.local
ADMIN_PASSWORD=Admin@12345
# REDIS_PASSWORD=

# ---- Kafka (messaging) ------------------------------------------------------
# false (default): payment -> policy goes through the outbox over HTTP, notifications over Feign.
# true: the outbox publishes payment.succeeded and every service publishes notification.requested; policy-service and
# notification-service consume them. Local broker: scripts\kafka-start.cmd (KRaft, localhost:9092);
# docker compose uses the kafka container (kafka:9092 inside, localhost:9094 from the host).
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
