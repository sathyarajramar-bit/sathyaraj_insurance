# Copy this file to .env (docker compose reads it automatically). Never commit .env.

# ---- Shared secrets ---------------------------------------------------------
# HMAC-SHA256 secret shared by auth-service (signs tokens) and api-gateway (verifies tokens).
# Must be at least 32 bytes. Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-me-with-a-random-string-of-at-least-32-characters

# ---- Config Server ----------------------------------------------------------
CONFIG_SERVER_USER=config-user
CONFIG_SERVER_PASSWORD=change-me-config-password

# ---- Infrastructure URLs (docker-compose overrides these per container) ----
EUREKA_URL=http://localhost:8761/eureka/
CONFIG_SERVER_URL=http://localhost:8888

# ---- CORS (comma separated origin patterns allowed at the gateway) ---------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# ---- Added in later phases --------------------------------------------------
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=insurance
MYSQL_PASSWORD=insurance
# First ADMIN account created by auth-service at startup (leave empty to skip)
ADMIN_EMAIL=admin@insurance.local
ADMIN_PASSWORD=Admin@12345
# REDIS_PASSWORD=
